<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{{ local_llm_server_label }}</string>
  <key>ProgramArguments</key>
  <array><string>{{ homebrew_prefix }}/bin/ollama</string><string>serve</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key><string>127.0.0.1:11434</string>
    <key>OLLAMA_KEEP_ALIVE</key><string>10m</string>
    <key>OLLAMA_MAX_LOADED_MODELS</key><string>2</string>
    <key>OLLAMA_NUM_PARALLEL</key><string>1</string>
    <key>OLLAMA_CONTEXT_LENGTH</key><string>32768</string>
    <key>OLLAMA_NO_CLOUD</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>{{ ansible_facts.user_dir }}/Library/Logs/ollama/ollama.log</string>
  <key>StandardErrorPath</key><string>{{ ansible_facts.user_dir }}/Library/Logs/ollama/ollama.log</string>
</dict>
</plist>
